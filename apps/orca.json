{
  "id": "orca",
  "display_name": "Orca",
  "upstream_repo": "stablyai/orca",
  "default_ref": "v1.4.261",
  "toolchain": "pnpm-bun-native",
  "target": "windows-x64",
  "formats": [
    "folder"
  ],
  "preferred_format": "folder",
  "data_portability": "no-install-standalone-folder-profile-not-isolated",
  "smoke": {
    "mode": "folder-process",
    "executable": "Orca.exe",
    "process_name": "Orca.exe",
    "wait_seconds": 30,
    "env": {
      "ORCA_BACKGROUND_LAUNCH": "1",
      "ORCA_STARTUP_DIAGNOSTICS": "1",
      "ORCA_DIAGNOSTICS_TOKEN_URL": ""
    },
    "startup_log_env": "ORCA_STARTUP_DIAGNOSTICS_FILE",
    "startup_log_marker": "[bootstrap] bundle-enter"
  },
  "min_size_mb": 30
}
